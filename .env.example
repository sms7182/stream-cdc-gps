# Copy to .env and fill in. .env is git-ignored.

# Public IP or DNS name of the server Kafka runs on. External clients
# connect to <this>:9094. Use localhost when everything runs on your machine.
KAFKA_EXTERNAL_HOST=localhost

# Only for running the Go app outside Docker (inside Docker it is kafka:9092).
KAFKA_URL=localhost:9094
KAFKA_PRODUCER_TOPIC=gps-data
# Postgres is used by the Kafka Connect JDBC sink, not by the Go app.
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=trafficdb

# ClickHouse (analytics store, reads Kafka topic gps-data)
CLICKHOUSE_USER=gps
CLICKHOUSE_PASSWORD=change-me

# Go module source for building gps-app. Use "direct" (or another reachable
# proxy) if proxy.golang.org returns 403 Forbidden.
GOPROXY=https://proxy.golang.org,direct
